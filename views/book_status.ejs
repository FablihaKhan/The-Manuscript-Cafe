<!-- book_status.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title>Book Status</title>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <style>
    body {
            font-family: 'Arial', sans-serif;
            background-image: url('/uploads/book_status_bg.png');
            background-repeat: no-repeat;
            background-size: cover;
            margin: 0;
            padding: 0;
            text-align: center;
        }

    h1 {
      color: #333;
    }

    ul {
      list-style-type: none;
      padding: 0;
    }

    li {
      margin-bottom: 10px;
    }

    .pending {
      color: #FFA500;
    }

    .approved {
      color: #008000;
    }

    .rejected {
      color: #FF0000;
    }
    .nav-tabs {
            margin-bottom: 20px;
        }

        .nav-item {
            margin-right: 10px;
        }

        .nav-link {
            color: #000;
        }

        .nav-link.active {
            font-weight: bold;
            color: #007bff;
        }

  </style>
</head>
<body>
  
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="#">Book Status</a>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
            </li>
            <li class="nav-item">
                <a href="/statistics" class="nav-link">Statistcs</a>
            </li>
            <li class="nav-item">
                <a href="/author/search" class="nav-link">SEARCH FOR YOUR BOOK</a>
            </li>
        </ul>
    </div>
</nav>


  <div class="container">
    <div class="row justify-content-center">
      <div class="card" style="width: 40rem;">
        <img src="/uploads/books.jpg" class="card-img-top" alt="...">
        <div class="card-body">
          <h5 class="card-title">Pending Books</h5>
        </div>
        <% pendingBooks.forEach(function(book) { %>
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><%= book.publisher_name %> - <%= book.book_name %>
              <form method="POST" action="/author/book_status">
                <input type="hidden" name="bookName" value="<%= book.book_name %>">
                <button type="submit">Cancel Request</button>
              </form>
            </li>
          </ul>
        <% }); %>
      </div>
    </div>
  </div>

<div class="container">
  <div class="row justify-content-center">
    <div class="card" style="width: 40rem;">
      <img src="/uploads/approve.png" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Approved Books</h5>
      </div>
      <% approvedBooks.forEach(function(book) { %>
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><%= book.publisher_name %> - <%= book.book_name %></li>
        </ul>
      <% }); %>
    </div>
  </div>
</div>

<div class="container">
  <div class="row justify-content-center">
    <div class="card" style="width: 40rem;">
      <img src="/uploads/rejected.png" class="card-img-top" alt="...">
      <div class="card-body">
        <h5 class="card-title">Rejected Books</h5>
      </div>
      <% rejectedBooks.forEach(function(book) { %>
        <ul class="list-group list-group-flush"></ul>
        <li class="list-group-item"><%= book.publisher_name %> - <%= book.book_name %> (Rejection Reason: <%= book.rejection_reason %>)</li>
      </ul>
      <% }); %>
    </div>
  </div>
</div>

</body>
</html>