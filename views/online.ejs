<%- include('partials/rolehead', {
  role: 'reader', pageTitle: 'পাঠক ড্যাশবোর্ড',
  userName: (typeof user !== 'undefined' && user) ? (user.user_name || '') : '',
  nav: [
    { href: '/online/reader/search', label: 'বই খুঁজুন' },
    { href: '/subscribe', label: 'সাবস্ক্রিপশন' }
  ]
}) %>

<h1>অনলাইন পাঠাগার</h1>
<p class="sub">সাবস্ক্রিপশন নিয়ে বই পড়ুন, রেটিং ও রিভিউ দিন।</p>

<div class="taskbar reader">
  <div style="flex:1">
    <div class="tb-title">📖 পাঠকের দায়িত্ব</div>
    <ul>
      <li>সাবস্ক্রিপশন নিয়ে অনলাইন বই পড়া</li>
      <li>নাম বা ধরন দিয়ে বই খোঁজা</li>
      <li>বইয়ে রেটিং ও রিভিউ দেওয়া</li>
      <li>পছন্দের তালিকা তৈরি করা</li>
    </ul>
  </div>
  <div style="text-align:right">
    <div class="muted">সাবস্ক্রিপশন শেষ হবে</div>
    <strong><%= (typeof remainingTime !== 'undefined' && remainingTime) ? remainingTime : 'তথ্য নেই' %></strong>
  </div>
</div>

<div class="card tight" style="margin-bottom:1.2rem">
  <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
    <span class="muted">ধরন:</span>
    <% ['Fantasy','Drama','Mystery','Science Fiction','Thriller','Romance'].forEach(function (g) { %>
      <a class="btn small ghost" href="/online/reader/search?genre=<%= encodeURIComponent(g) %>"><%= g %></a>
    <% }) %>
    <a class="btn small" href="/online/reader/search" style="margin-left:auto">বই খুঁজুন</a>
  </div>
</div>

<h2>বইসমূহ</h2>
<% if (!books || !books.length) { %>
  <div class="card empty">এখন কোনো বই নেই।</div>
<% } else { %>
  <div class="book-grid">
    <% books.forEach(function (book) { %>
      <div class="book-card">
        <h4><%= book.book_title %></h4>
        <p class="muted" style="margin:.2rem 0"><%= book.genre || '' %></p>
        <div style="display:flex;gap:.4rem;margin-top:.6rem;flex-wrap:wrap">
          <% if (book.pdf_url) { %>
            <a class="btn small" href="<%= book.pdf_url %>" target="_blank" rel="noopener">পড়ুন</a>
          <% } %>
          <form action="/reader/review_rate" method="post" style="margin:0">
            <input type="hidden" name="bookId" value="<%= book.book_id %>">
            <button class="btn small ghost" type="submit">রিভিউ / রেটিং</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/foot') %>
