<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Section</title>
    <link rel="stylesheet" href="node_modules/bootstrap/dist/css/bootstrap.css">
    <style>
        body {
            background-color: #f8f9fa;
            color: #333;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            padding: 50px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            background-color: #fff;
        }

        h2 {
            color: #007bff;
            margin-bottom: 30px;
            text-transform: uppercase;
        }

        .book-card {
            margin: 0 10px 20px;
            width: calc(33.33% - 20px); /* Adjust based on the number of cards per row */
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease-in-out;
            background-color: #fff;
            display: inline-block;
            vertical-align: top;
        }

        .book-card:hover {
            transform: translateY(-5px);
        }

        .card-img-top {
            object-fit: cover;
            height: 200px;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .card-body {
            padding: 20px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .card-text {
            color: #666;
        }

        .see-all-btn {
            background-color: #007bff !important;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            text-transform: uppercase;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }

        .see-all-btn:hover {
            background-color: #0056b3 !important;
        }

        /* Search bar */
        .search-bar {
            margin-bottom: 20px;
        }

        .search-input {
            width: 70%;
            padding: 10px;
            border-radius: 5px 0 0 5px;
            border: 1px solid #ced4da;
            border-right: none;
            outline: none;
        }

        .search-btn {
            width: 30%;
            padding: 10px;
            border: none;
            border-radius: 0 5px 5px 0;
            background-color: #007bff;
            color: #fff;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .search-btn:hover {
            background-color: #0056b3;
        }

        /* Media query for responsiveness */
        @media (max-width: 992px) {
            .book-card {
                width: calc(50% - 20px); /* Two cards per row on medium devices */
            }
        }

        @media (max-width: 576px) {
            .book-card {
                width: 100%; /* One card per row on small devices */
            }
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center">Online Section - Books</h2>

        <!-- Search bar -->
        <div class="search-bar">
            <input type="text" class="search-input" placeholder="Search for books...">
            <button class="search-btn">Search</button>
        </div>

        <!-- Book Categories -->
        <div class="row mb-4">
            <div class="col-md-3">
                <a href="#" class="btn btn-primary btn-block category-btn">Fantasy</a>
            </div>
            <div class="col-md-3">
                <a href="#" class="btn btn-primary btn-block category-btn">Drama</a>
            </div>
            <div class="col-md-3">
                <a href="#" class="btn btn-primary btn-block category-btn">Mystery</a>
            </div>
            <div class="col-md-3">
                <a href="#" class="btn btn-primary btn-block category-btn">Science Fiction</a>
            </div>
        </div>

        <!-- Featured Book Cards -->
        <div class="row">
            <% books.forEach((book, index) => { %>
                <div class="col-md-4">
                    <div class="card book-card">
                        <!-- Use a placeholder image from Lorem Picsum -->
                        <img src="https://picsum.photos/300/200" class="card-img-top" alt="Book Cover">
                        <div class="card-body">
                            <h5 class="card-title"><%= book.book_title %></h5>
                            <p class="card-text">Author: <%= book.author_code %></p>
                            <!-- Add other book details as needed -->
                            <a href="<%= book.pdf_url %>" class="btn btn-primary">Read Now</a>
                        </div>
                    </div>
                </div>
                <% if ((index + 1) % 3 === 0) { %>
                    </div><div class="row">
                <% } %>
            <% }); %>
        </div>

        <!-- See All Books Button -->
        <div class="text-center mt-4">
            <a href="#" class="btn see-all-btn">See All Books</a>
        </div>
    </div>
</body>
</html>
