<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login</title>
    <!-- Link to Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-image: url('background-image.jpg');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
        }

        .dashboard-container {
            max-width: 800px;
            width: 100%;
            padding: 20px;
            margin-top: 70px; /* Adjusted margin-top to give space for the fixed navbar */
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            background-color: #fff;
        }

        .nav-tabs {
            margin-bottom: 20px;
        }

        .nav-item {
            margin-right: 10px;
        }

        .nav-link {
            color: #000;
        }

        .nav-link.active {
            font-weight: bold;
            color: #007bff;
        }

        .card {
            width: 100%; /* Make the card width match the width of the dashboard container */
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="#">Author Profile</a>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
            </li>
            <li class="nav-item">
                <a href="/author/edit" class="nav-link">Edit Profile</a>
            </li>
            <li class="nav-item">
                <a href="/author/search" class="nav-link">SEARCH FOR YOUR BOOK</a>
            </li>
        </ul>
    </div>
</nav>

<div class="dashboard-container">
    <h1 class="text-center mb-4">Author Profile</h1>

    <!-- Dynamically generate cards based on data from the database -->
    <div class="card">
        <img src="/uploads/author.jpg" class="card-img-top" alt="Author Image">
        <div class="card-body">
          <h5 class="card-title"><%= user.first_name %> <%= user.last_name %></h5>
          <p class="card-text">Gender: <%= user.gender %></p>
          <p class="card-text">Email: <%= user.email %></p>
          <p class="card-text">Contact No: <%= user.contact_no %></p>
          <p class="card-text">Genre: <%= user.interested_genre %></p>
    
          <a href="/author/request" class="btn btn-danger">Make Request to Publisher</a>
          <a href="/author/book_status" class="btn btn-danger">Book Status</a>
        </div>
    </div>
</div>

<!-- Link to Bootstrap JS and Popper.js (if needed for Bootstrap's JavaScript features) -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.8/dist/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
