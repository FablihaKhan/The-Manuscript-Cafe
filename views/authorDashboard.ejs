<%- include('partials/rolehead', {
  role: 'author', pageTitle: 'লেখক ড্যাশবোর্ড',
  userName: (user.first_name || '') + ' ' + (user.last_name || ''),
  logout: '/author/logout',
  nav: [
    { href: '/studio', label: 'স্টুডিও' },
    { href: '/author/request', label: 'প্রকাশ-অনুরোধ' },
    { href: '/author/book_status', label: 'বইয়ের অবস্থা' },
    { href: '/author/edit', label: 'প্রোফাইল' }
  ]
}) %>

<h1>স্বাগতম, <%= user.first_name %> <%= user.last_name %></h1>
<p class="sub">লেখক হিসেবে আপনার সব কাজ এক জায়গায়।</p>

<div class="taskbar author">
  <div style="flex:1">
    <div class="tb-title">✍️ লেখকের দায়িত্ব</div>
    <ul>
      <li>পাণ্ডুলিপি লেখা ও আপলোড করা</li>
      <li>Manuscript Doctor দিয়ে যাচাই করা</li>
      <li>ফরম্যাট, প্রচ্ছদ ও Metadata তৈরি</li>
      <li>উপযুক্ত প্রকাশক খুঁজে সাবমিশন</li>
      <li>বিটা রিডার ও পেশাজীবী নিয়োগ</li>
      <li>বিক্রয় ও পাঠক বিশ্লেষণ দেখা</li>
    </ul>
  </div>
</div>

<div class="grid two">
  <div class="card">
    <h2 style="margin-top:0">🖋️ রাইটার্স স্টুডিও</h2>
    <p class="muted">পাণ্ডুলিপি থেকে প্রকাশ পর্যন্ত সম্পূর্ণ যাত্রা — ডক্টর, প্রস্তুতি স্কোর, ফরম্যাট, প্রকাশক মিল, ট্র্যাকার।</p>
    <a class="btn" href="/studio">স্টুডিওতে যান</a>
    <a class="btn ghost" href="/studio/upload">নতুন পাণ্ডুলিপি</a>
  </div>

  <div class="card">
    <h2 style="margin-top:0">📮 প্রথাগত প্রকাশ-অনুরোধ</h2>
    <p class="muted">সরাসরি প্রকাশকের কাছে প্রকাশের অনুরোধ পাঠান ও অবস্থা দেখুন।</p>
    <a class="btn ghost" href="/author/request">প্রকাশকের কাছে অনুরোধ</a>
    <a class="btn ghost" href="/author/book_status">বইয়ের অবস্থা</a>
    <a class="btn ghost" href="/author/search">আমার বই খুঁজুন</a>
  </div>
</div>

<div class="card">
  <h2 style="margin-top:0">আমার পরিচিতি</h2>
  <div class="grid two">
    <div>
      <p class="muted" style="margin:.2rem 0">নাম</p><strong><%= user.first_name %> <%= user.last_name %></strong>
      <p class="muted" style="margin:.8rem 0 .2rem">ইমেইল</p><strong><%= user.email %></strong>
    </div>
    <div>
      <p class="muted" style="margin:.2rem 0">যোগাযোগ</p><strong><%= user.contact_no || '—' %></strong>
      <p class="muted" style="margin:.8rem 0 .2rem">পছন্দের ধরন</p><strong><%= user.interested_genre || '—' %></strong>
    </div>
  </div>
  <p style="margin-top:1rem"><a class="btn ghost" href="/author/edit">প্রোফাইল সম্পাদনা</a></p>
</div>

<%- include('partials/foot') %>
