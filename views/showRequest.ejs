<%- include('partials/rolehead', {
  role: 'publisher', pageTitle: 'প্রকাশক ড্যাশবোর্ড',
  userName: publisher.name, logout: '/author/logout',
  nav: [
    { href: '/publisher/request/search', label: 'অনুরোধ খুঁজুন' },
    { href: '/publisher/send_edit', label: 'সম্পাদকের কাছে পাঠান' },
    { href: '/statistics', label: 'পরিসংখ্যান' }
  ]
}) %>

<h1>স্বাগতম, <%= publisher.name %></h1>
<p class="sub">লেখকের পাঠানো প্রকাশ-অনুরোধ পর্যালোচনা করে সিদ্ধান্ত নিন।</p>

<div class="taskbar publisher">
  <div style="flex:1">
    <div class="tb-title">🏢 প্রকাশকের দায়িত্ব</div>
    <ul>
      <li>লেখকের প্রকাশ-অনুরোধ পর্যালোচনা</li>
      <li>পাণ্ডুলিপি অনুমোদন বা প্রত্যাখ্যান</li>
      <li>অনুমোদিত বই সম্পাদকের কাছে পাঠানো</li>
      <li>ধরন অনুযায়ী অনুরোধ খোঁজা</li>
      <li>শীর্ষ লেখক ও আর্থিক পরিসংখ্যান দেখা</li>
    </ul>
  </div>
</div>

<div class="stat-row">
  <div class="stat publisher">
    <div class="n"><%= bn(pendingBooks) %></div>
    <div class="l">অপেক্ষমাণ অনুরোধ</div>
  </div>
  <div class="stat publisher">
    <div class="n"><%= bn(authorRequests.length) %></div>
    <div class="l">মোট প্রাপ্ত অনুরোধ</div>
  </div>
  <div class="stat publisher">
    <div class="n"><%= bn(top_rated_author.length) %></div>
    <div class="l">শীর্ষ রেটেড লেখক</div>
  </div>
</div>

<div class="grid two">
  <div class="card" style="grid-column:1/-1">
    <h2 style="margin-top:0">📥 লেখকের প্রকাশ-অনুরোধ</h2>
    <% if (authorRequests.length > 0) { %>
      <div style="overflow-x:auto">
      <table>
        <thead>
          <tr><th>লেখক</th><th>ইমেইল</th><th>বই</th><th>ধরন</th><th>PDF</th><th>সিদ্ধান্ত</th></tr>
        </thead>
        <tbody>
          <% authorRequests.forEach(function (r) { %>
            <tr>
              <td><%= r.first_name %> <%= r.last_name || '' %></td>
              <td class="muted"><%= r.email %></td>
              <td><%= r.book_name %></td>
              <td><span class="pill grey"><%= r.genre %></span></td>
              <td><% if (r.pdf_link) { %><a href="<%= r.pdf_link %>" target="_blank" rel="noopener">দেখুন</a><% } else { %>—<% } %></td>
              <td>
                <div style="display:flex;gap:.4rem">
                  <form action="/publisher/approve" method="POST">
                    <input type="hidden" name="request_id" value="<%= r.request_id %>">
                    <button type="submit" class="btn small">অনুমোদন</button>
                  </form>
                  <form action="/publisher/reject" method="POST">
                    <input type="hidden" name="request_id" value="<%= r.request_id %>">
                    <button type="submit" class="btn small ghost">প্রত্যাখ্যান</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } else { %>
      <div class="empty">এখন কোনো প্রকাশ-অনুরোধ নেই।</div>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0">⭐ শীর্ষ রেটেড লেখক</h2>
    <% if (top_rated_author.length) { %>
      <% top_rated_author.forEach(function (a) { %>
        <div style="padding:.5rem 0;border-bottom:1px solid var(--line)">
          <strong><%= a.first_name %> <%= a.last_name %></strong>
        </div>
      <% }); %>
    <% } else { %>
      <p class="muted">এখনো যথেষ্ট রিভিউ নেই।</p>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0">দ্রুত কাজ</h2>
    <p><a class="btn ghost" href="/publisher/request/search">ধরন অনুযায়ী অনুরোধ খুঁজুন</a></p>
    <p><a class="btn ghost" href="/publisher/send_edit">অনুমোদিত বই সম্পাদকের কাছে পাঠান</a></p>
    <p><a class="btn ghost" href="/statistics">আর্থিক পরিসংখ্যান দেখুন</a></p>
  </div>
</div>

<%- include('partials/foot') %>
