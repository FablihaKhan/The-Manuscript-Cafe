<!DOCTYPE html>
<html>
<head>
  <title>Book Requests</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #f2f2f2;
    }
    .pending-count {
      font-weight: bold;
      color: red; /* or any color you prefer */
    }
  </style>
</head>
<body>
  <h1>Welcome, <%= publisher.name %>!</h1>
  <a href="/publisher/request/search">Search based on criteria</a>

  <h2>Pending Books</h2>
  <p>Total Pending Books: <span class="pending-count"><%= pendingBooks %></span></p>

  <% if (authorRequests.length > 0) { %>
    <h2>Author Requests and Requested Books</h2>
    <table>
      <tr>
        <th>Author Name</th>
        <th>Author Email</th>
        <th>Expertise</th>
        <th>Book Title</th>
        <th>Genre</th>
        <th>PDF link</th>
        <th>Actions</th> <!-- New column for buttons -->
      </tr>
      <% authorRequests.forEach((request) => { %>
        <tr>
          <td><%= request.first_name %></td>
          <td><%= request.email %></td>
          <td><%= request.interested_genre %></td>
          <td><%= request.book_name %></td>
          <td><%= request.genre %></td>
          <td><%= request.pdf_link %></td>
          <td>
            <form action="/publisher/approve" method="POST" style="display: inline;">
              <input type="hidden" name="request_id" value="<%= request.request_id %>">
              <button type="submit">Approve</button>
            </form>
            <form action="/publisher/reject" method="POST" style="display: inline;">
              <input type="hidden" name="request_id" value="<%= request.request_id %>">
              <button type="submit">Reject</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </table>
  <% } else { %>
    <p>No author requests found.</p>
  <% } %>
</body>
</html>