
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authors List</title>
</head>
<body>
    <h1>Authors List</h1>
    <ul>
        <% author.forEach(author => { %>
            <li><%= author.first_name %></li>
        <% }); %>
    </ul>
</body>
</html>
