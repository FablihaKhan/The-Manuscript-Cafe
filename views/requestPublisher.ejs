<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Publisher</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-image: url('/uploads/request2.png');
            background-repeat: no-repeat;
            background-size: cover;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        .publisher-box {
            border: 1px solid #ccc;
            padding: 20px;
            margin: 20px;
            display: inline-block;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .publisher-box p {
            margin: 0;
            padding: 5px 0;
        }

        .request-button {
            background-color: #DC143C;
            color: #fff;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 4px;
        }

        .request-button:hover {
            background-color: #DC143C;
        }

        .add-book-details-link {
            display: block;
            margin-top: 20px;
            color: #333;
        }

        .upload-button {
            background-color: #DC143C;
            color: #fff;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 4px;
        }

        .upload-button:hover {
            background-color: #DC143C;
        }
        .button-link {
            display: inline-block;
            padding: 10px 20px;
            background-color: #DC143C;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="#">Here are the publishers</a>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
            </li>
            <li class="nav-item">
                <a href="/statistics" class="nav-link">Statistics</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/author/request_to_all_publisher/book_details">Request to All publisher</a>
            </li>
        </ul>
    </div>
</nav>

    <h1>Request Publisher</h1>
    <% rows.forEach((row) => { %>
        <div class="publisher-box">
            
            <p><strong>Name:</strong> <%= row.name %></p>
            <p><strong>Email:</strong> <%= row.email %></p>
            <!-- Add more details as needed -->

            <!-- Button for requesting this particular row -->
            <form action="/author/request" method="post">
                <input type="hidden" name="authorId" value="<%= authorId %>">
                <input type="hidden" name="publisherId" value="<%= row.publisher_id %>">
                <button class="request-button" type="submit">Request</button>
            </form>

            <a href="/author/request/book_details" class="button-link">Upload Book Details</a>

        </div>
    <% }); %>

</body>
</html>
