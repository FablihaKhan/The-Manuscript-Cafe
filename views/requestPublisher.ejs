<!-- requestPublisher.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Publisher</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f8f8f8;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        .publisher-box {
            border: 1px solid #ccc;
            padding: 20px;
            margin: 20px;
            display: inline-block;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .publisher-box p {
            margin: 0;
            padding: 5px 0;
        }

        .request-button {
            background-color: #4CAF50;
            color: #fff;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 4px;
        }

        .request-button:hover {
            background-color: #45a049;
        }

        .add-book-details-link {
            display: block;
            margin-top: 20px;
            color: #333;
        }
    </style>
</head>
<body>
    <h1>Request Publisher</h1>
    <a class="add-book-details-link" href="/author/request/book_details">Click here to add book details after you have requested any publisher</a>
    <% rows.forEach((row) => { %>
        <div class="publisher-box">
            <p><strong>Publisher ID:</strong> <%= row.publisher_id %></p>
            <p><strong>Name:</strong> <%= row.name %></p>
            <p><strong>Email:</strong> <%= row.email %></p>
            <!-- Add more details as needed -->

            <!-- Button for requesting this particular row -->
            <form action="/author/request" method="post">
                <input type="hidden" name="authorId" value="<%= authorId %>">
                <input type="hidden" name="publisherId" value="<%= row.publisher_id %>">
                <button class="request-button" type="submit">Request</button>
            </form>
        </div>
    <% }); %>

</body>
</html>
