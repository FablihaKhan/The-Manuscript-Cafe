<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Statistics</title>
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <style>
    ul {
      list-style-type: none;
      padding: 0;
    }

    li {
      margin-bottom: 20px;
    }

    h1 {
      margin-top: 40px;
      margin-bottom: 20px;
    }

    .chart-container {
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <h1>Approval Rates by Publisher</h1>
        <ul>
          <% result.forEach(function(row) { %>
            <li>
              <strong>Publisher Name:</strong> <%= row.publisher_name %><br>
              <strong>Approval Rate:</strong> <%= row.approval_rate %>%<br>
            </li>
          <% }); %>
        </ul>
        <div class="chart-container">
          <h2>Approval Rate Chart</h2>
          <canvas id="approvalRateChart"></canvas>
          <input type="hidden" id="approvalRateData" value='<%- JSON.stringify(result) %>'>
        </div>
      </div>
      <div class="col-md-6">
        <h1>Financial Statistics</h1>
        <ul>
          <li><strong>Total Revenue:</strong> <%= revenue %></li>
          <li><strong>Total Cost:</strong> <%= total_cost %></li>
          <li><strong>Profit Margin:</strong> <%= profit_margin %></li>
        </ul>
        <div class="chart-container">
          <h2>Financial Statistics Chart</h2>
          <canvas id="financialStatisticsChart"></canvas>
          <input type="hidden" id="financialStatisticsData" value='<%- JSON.stringify({ revenue: revenue, total_cost: total_cost, profit_margin: profit_margin }) %>'>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <h1>Top Genres</h1>
        <!-- Card for displaying top genres -->
        <div class="card" style="width: 18rem;">
          <div class="card-body">
            <h5 class="card-title">Top Genres</h5>
            <ul class="list-group list-group-flush">
              <% genres.forEach(function(row) { %>
                <li class="list-group-item">
                  <strong>Genre Name:</strong> <%= row.genre_name %><br />
                  <strong>Submission Count:</strong> <%= row.submission_count %><br />
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
  <script>
    // Retrieve data from the input elements
    var approvalRateData = JSON.parse(document.getElementById('approvalRateData').value);
    var financialStatisticsData = JSON.parse(document.getElementById('financialStatisticsData').value);

    // Define arrays to hold approval rates and publisher names
    var approvalRates = approvalRateData.map(function(row) {
      return row.approval_rate;
    });
    var publisherNames = approvalRateData.map(function(row) {
      return row.publisher_name;
    });

    // Define labels and data for the financial statistics chart
    var financialLabels = ['Total Revenue', 'Total Cost', 'Profit Margin'];
    var financialData = [financialStatisticsData.revenue, financialStatisticsData.total_cost, financialStatisticsData.profit_margin];

    // Create a new Chart object for the approval rate chart
    var approvalRateCtx = document.getElementById('approvalRateChart').getContext('2d');
    var approvalRateChart = new Chart(approvalRateCtx, {
      type: 'bar',
      data: {
        labels: publisherNames,
        datasets: [{
          label: 'Approval Rate (%)',
          data: approvalRates,
          backgroundColor: 'rgba(54, 162, 235, 0.6)',
          borderColor: 'rgba(54, 162, 235, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: 'Approval Rate (%)'
            }
          },
          x: {
            title: {
              display: true,
              text: 'Publisher Name'
            }
          }
        }
      }
    });
  
    
    // Retrieve data from the input element
  var financialStatisticsData = JSON.parse(document.getElementById('financialStatisticsData').value);

// Define labels and data for the financial statistics chart
var financialLabels = ['Total Revenue', 'Total Cost', 'Profit Margin'];
var financialData = [financialStatisticsData.revenue, financialStatisticsData.total_cost, financialStatisticsData.profit_margin];

// Create a new Chart object for the financial statistics chart
var financialStatisticsCtx = document.getElementById('financialStatisticsChart').getContext('2d');
var financialStatisticsChart = new Chart(financialStatisticsCtx, {
  type: 'pie',
  data: {
    labels: financialLabels,
    datasets: [{
      data: financialData,
      backgroundColor: [
        'rgba(255, 99, 132, 0.6)',
        'rgba(54, 162, 235, 0.6)',
        'rgba(75, 192, 192, 0.6)'
      ],
      borderColor: [
        'rgba(255, 99, 132, 1)',
        'rgba(54, 162, 235, 1)',
        'rgba(75, 192, 192, 1)'
      ],
      borderWidth: 1
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        position: 'bottom',
      },
      title: {
        display: true,
        text: 'Financial Statistics'
      }
    }
  }
});
  </script>
</body>
</html>