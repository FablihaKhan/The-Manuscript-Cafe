<!-- editProfile.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
</head>
<body>
    <h1>Edit Profile</h1>
    <form action="/author/edit" method="POST" id="registrationForm">
        <label for="first_name">First Name:</label>
        <input type="text" id="first_name" name="first_name" value="<%= author.first_name %>" ><br>

        <label for="last_name">Last Name:</label>
        <input type="text" id="last_name" name="last_name" value="<%= author.last_name %>"><br>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= author.email %>" ><br>

        <label for="contact_no">Contact No:</label>
        <input type="text" id="contact_no" name="contact_no" value="<%= author.contact_no %>"><br>

        <label for="gender">Gender:</label>
        <select id="gender" name="gender" required>
            <option value="Male" <%= author.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= author.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= author.gender === 'Other' ? 'selected' : '' %>>Other</option>
        </select><br>

        <label for="interested_genre">Interested Genre:</label>
        <input type="text" id="interested_genre" name="interested_genre" value="<%= author.interested_genre %>" ><br>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" value="<%= author.password %>" ><br>

        <button type="submit">Update Profile</button>
    </form>

     <!-- Your JavaScript code -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    $('#registrationForm').submit(function(event) {
      event.preventDefault(); // Prevent default form submission
      var formData = $(this).serialize(); // Serialize form data
  
      $.post('/author/register', formData)
        .done(function(response) {
          // Handle success response
          if (response.success) {
            // Display success message or redirect
            alert(response.message);
            // Redirect example:
            // window.location.href = '/success-page';
          } else {
            // Display error message
            alert(response.message);
          }
        })
        .fail(function(xhr, status, error) {
          // Handle error response
          console.error('Error:', error);
          // Display generic error message
          alert('Another author with the same email or password already exists');
        });
    });
  </script>
</body>
</html>
