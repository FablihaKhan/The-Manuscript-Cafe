
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streaming Service - Aesthetic Style</title>
    <link rel="stylesheet" href="node_modules/bootstrap/dist/css/bootstrap.css">
    <style>
        body {
            /* Use the URL of your background image */
            background-image: url('https://th.bing.com/th/id/OIG2.oRlQYyZ2tlXR8B6n8Btu?w=1024&h=1024&rs=1&pid=ImgDetMain');
            background-size: cover; /* Cover the entire background */
            background-position: center; /* Center the background image */
            color: #fff; /* White text color */
            font-family: 'Arial', sans-serif;
            font-size: 24px; /* Larger font size */
            margin: 0;
            padding: 0;
        }

        .container {
            text-align: center;
            padding: 100px;
        }

        h1 {
            font-size: 3.5rem; /* Larger font size for heading */
            margin-bottom: 50px; /* Increased margin below heading */
            color: #e50914; /* Red heading color */
        }

        .btn-subscribe,
        .btn-login {
            font-size: 2rem; /* Larger font size for buttons */
            padding: 20px 40px; /* Increased padding for buttons */
            margin: 20px; /* Increased margin for buttons */
            border-radius: 10px; /* Rounded corners for buttons */
            letter-spacing: 1px;
            font-weight: bold;
            text-transform: uppercase; /* Uppercase text for buttons */
        }

        .btn-subscribe {
            background-color: #000; /* Black button background */
            border: 2px solid #e50914; /* Red border for contrast */
            color: #fff; /* White text color */
        }

        .btn-subscribe:hover {
            background-color: #e50914; /* Red background color on hover */
            color: #fff; /* White text color on hover */
        }

        .btn-login {
            background-color: #e50914; /* Red button background */
            border: none; /* No border */
            color: #fff; /* White text color */
        }

        .btn-login:hover {
            background-color: #000; /* Black background color on hover */
        }
    </style>
</head>

<body>
    <script src="node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <div class="container">
        <h1>Welcome to Our Streaming Service</h1>
        <a href="/subscribe" class="btn btn-subscribe" onclick="subscribe()">Subscribe Now</a>
        <a href="/login_reader" class="btn btn-login" onclick="login()">Login</a>
    </div>

    <script>
        function subscribe() {
            // Redirect to subscribe.html after clicking Subscribe
            window.location.href = 'sub_form.ejs';
        }

        function login() {
            // Redirect to login.html after clicking Login
            window.location.href = 'login.ejs';
        }
    </script>
</body>

</html>