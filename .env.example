# Copy to .env and fill in. .env must never be committed.
PGUSER=postgres
PGHOST=localhost
PGDATABASE=Maindb
PGPASSWORD=change-me
PGPORT=5432

SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
BASE_URL=http://localhost:3000

# Optional. Without it every AI feature falls back to the offline heuristic engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
